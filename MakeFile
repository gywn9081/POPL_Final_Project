# 		exit 1; \
# 	else \
# 		echo "Running test: $(TEST_FILE)"; \
# 		python3 $(TEST_FILE); \
# 	fi

clean:
	rm -rf $(BUILD_DIR)

# Show which dir we are deleting
test-clean:
	echo $(BUILD_DIR)